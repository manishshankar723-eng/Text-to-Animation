# Secrets — NEVER commit
.env
# ...including backups. A copy of .env is still a copy of your credentials.
.env.bak*
.env.*.bak

# Local dev user store (contains bcrypt password hashes)
.local_users.json
.local_jobs.json
.local_jobs.json.tmp
# Autosaved script drafts (local fallback store — the user's own writing)
.local_drafts.json
# The app's own name and mark, when the local store is in use. It is a
# DEPLOYMENT's branding, not the project's — committing one deployment's name
# would rename every other checkout on its next start.
.local_branding.json

# Python
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# Output files
output/
uploads/
*.zip

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store
*_probe_failed.png
